#!/usr/bin/env bash
# demo: drive the amorphic MLP demo one stage at a time.
# Run ./demo help for usage.
set -euo pipefail

ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(git -C "$ENV_DIR" rev-parse --show-toplevel)"
RUN_DIR="$ENV_DIR/.run"
APP_URL="${APP_URL:-http://localhost:8080}"
STAGES="0 1 1b 2 3 3b 4"
ALL_SERVICES="py-pricing java-pricing"
TOOLING="inventory governor"

die() { echo "demo: $*" >&2; exit 1; }
say() { printf '\n\033[1m%s\033[0m\n' "$*"; }
compose() { docker compose -f "$ENV_DIR/compose.yaml" "$@"; }
# Quiet variant for stage changes; build and start errors are still printed.
quiet_compose() { docker compose --progress quiet -f "$ENV_DIR/compose.yaml" "$@"; }

# Sets SERVICES (pricing services to run), JAVA_VERSION, FOLD_IN, DESCRIPTION.
stage_config() {
  FOLD_IN=false
  JAVA_VERSION=v2.1
  case "$1" in
    0)  SERVICES="py-pricing"
        DESCRIPTION="Baseline. Python serves; nothing is compared." ;;
    1)  SERVICES="py-pricing java-pricing"; JAVA_VERSION=v2.0
        DESCRIPTION="Shadow. Python serves; Java v2.0 is compared in the background. Expect .xx5 mismatches and a failing gate." ;;
    1b) SERVICES="py-pricing java-pricing"
        DESCRIPTION="Fix. Python serves; Java v2.1 (HALF_EVEN fix plus regression test) is compared. Expect the gate to pass." ;;
    2)  SERVICES="py-pricing java-pricing"
        DESCRIPTION="Canary. Java v2.1 serves a weighted share of calls; Python is compared on those calls." ;;
    3)  SERVICES="py-pricing java-pricing"
        DESCRIPTION="Promote. Roles reversed: Java v2.1 serves; Python is compared." ;;
    3b) SERVICES="java-pricing"
        DESCRIPTION="Deprecate. Java v2.1 serves alone; Python is stopped." ;;
    4)  SERVICES=""; FOLD_IN=true
        DESCRIPTION="Fold-in. The app is rebuilt with pricing-calc-core in-process; the Java service is removed." ;;
    *)  die "unknown stage '$1' (stages: $STAGES)" ;;
  esac
}

addresses_file() {
  local f="$ENV_DIR/addresses/stage-$1.yaml"
  [[ -f "$f" ]] || die "no address table for stage '$1' (stages: $STAGES)"
  echo "$f"
}

# Builds the Java service image from its git tag, so the working tree never has to change.
build_java_image() {
  local version="$1" tag="pricing-calc-java/$1" image="amorphic/pricing-calc-java:$1"
  if [[ "${REBUILD:-0}" != 1 ]] && docker image inspect "$image" >/dev/null 2>&1; then
    return
  fi
  git -C "$REPO_ROOT" rev-parse -q --verify "refs/tags/$tag" >/dev/null \
    || die "git tag '$tag' not found. Create it once Java $version is built (see docs/amorphic-mlp-plan.md, build order)."
  say "Building $image from tag $tag"
  local tmp
  tmp="$(mktemp -d)"
  git -C "$REPO_ROOT" archive "refs/tags/$tag" | tar -x -C "$tmp"
  docker build -t "$image" -f "$tmp/pricing-calc-java/pricing-calc-service/Dockerfile" "$tmp" \
    || { rm -rf "$tmp"; die "docker build failed for $image"; }
  rm -rf "$tmp"
}

wait_for_app() {
  local i
  for i in $(seq 1 60); do
    if curl -fsS -o /dev/null "$APP_URL/actuator/health" 2>/dev/null; then return; fi
    sleep 1
  done
  die "app did not become healthy at $APP_URL within 60s (try: ./demo logs app)"
}

# Host port of each pricing service's /health (see compose.yaml).
health_url() {
  case "$1" in
    py-pricing)   echo "http://localhost:8000/health" ;;
    java-pricing) echo "http://localhost:8090/health" ;;
    inventory)    echo "http://localhost:8100/health" ;;
    governor)     echo "http://localhost:8110/health" ;;
  esac
}

wait_for_service() {
  local url i
  url="$(health_url "$1")"
  for i in $(seq 1 60); do
    if curl -fsS -o /dev/null "$url" 2>/dev/null; then return; fi
    sleep 1
  done
  die "$1 did not answer $url within 60s (try: ./demo logs $1)"
}

app_running() {
  [[ -n "$(compose ps --status running -q app 2>/dev/null)" ]] \
    && curl -fsS -o /dev/null "$APP_URL/actuator/health" 2>/dev/null
}

# POSTs an address table to the running app. Prints the outcome; returns 1 if the app rejected it.
post_table() {
  local file="$1" source="$2" code
  code="$(curl -sS -o "$RUN_DIR/apply.json" -w '%{http_code}' -X POST \
    -H 'Content-Type: application/yaml' -H "X-Table-Source: $source" \
    --data-binary @"$file" "$APP_URL/admin/address-table")" || die "cannot reach the app at $APP_URL"
  if [[ "$code" == 200 ]]; then
    jq -r '"Applied without restart: generation \(.generation)\n  \(.routing)"' "$RUN_DIR/apply.json"
    return 0
  fi
  echo "The app rejected the table (HTTP $code):" >&2
  jq -r '"  \(.error)\nStill live (generation \(.generation)): \(.kept)"' "$RUN_DIR/apply.json" >&2 2>/dev/null \
    || cat "$RUN_DIR/apply.json" >&2
  return 1
}

# Prints the change from the active table to $2 (label $3), if there is an active table.
show_change() {
  local next="$1" label="$2"
  [[ -f "$RUN_DIR/addresses.yaml" ]] || return 0
  cmp -s "$RUN_DIR/addresses.yaml" "$next" && return 0
  local previous="?"
  [[ -f "$RUN_DIR/stage" ]] && previous="$(cat "$RUN_DIR/stage")"
  say "Address table change ($previous -> $label):"
  diff -u --label "active ($previous)" --label "$label" "$RUN_DIR/addresses.yaml" "$next" || true
}

# Starts the given pricing services (Java at $JAVA_VERSION) and waits for each one's /health.
start_services() {
  local services="$1" svc
  [[ -n "$services" ]] || return 0
  case " $services " in *" java-pricing "*) build_java_image "$JAVA_VERSION" ;; esac
  export JAVA_VERSION
  say "Starting services (the first build of each image takes a few minutes)"
  # shellcheck disable=SC2086
  quiet_compose up -d --build $services
  for svc in $services; do wait_for_service "$svc"; done
}

# Stops the pricing services that aren't in the given list.
stop_unused_services() {
  local services="$1" svc
  for svc in $ALL_SERVICES; do
    case " $services " in
      *" $svc "*) ;;
      *) quiet_compose rm -sf "$svc" >/dev/null 2>&1 || true ;;
    esac
  done
}

# Tooling entries (inventory, governor) in an address table. Stage files hold only pricing-calc;
# ./demo keeps the tooling entries in .run/tooling.yaml and adds them to every table it applies,
# so a stage change never moves the tooling. Only ./demo tooling (or ./demo apply) does.

# Prints a table without its tooling entries ($2 = keep), or only its tooling entries ($2 = tooling).
split_tooling() {
  awk -v want="$2" '
    /^[^ ]/ { tool = 0; if (want == "keep") print; next }
    /^  [^ ]/ { cap = $1; sub(":$", "", cap); tool = (cap == "inventory" || cap == "governor") }
    { if ((want == "tooling") == tool) print }' "$1"
}

# Prints "remote" or "local" for tooling $1 in table file $2 (no entry means local, in-process).
tooling_mode() {
  [[ -f "$2" ]] || { echo local; return; }
  awk -v n="$1:" '/^  [^ ]/ { cur = $1 } cur == n && /type: remote/ { r = 1 } END { print (r ? "remote" : "local") }' "$2"
}

# Prints the address-table entry for tooling $1 bound $2 (local or remote; addresses as in catalogue.yaml).
tooling_entry() {
  printf '  %s:\n    champion:\n      address: pkg:amorphic/%s@0.1?lang=java\n' "$1" "$1"
  if [[ "$2" == remote ]]; then
    printf '      binding: { type: remote, url: http://%s:8080 }\n' "$1"
  else
    printf '      binding: { type: local }\n'
  fi
}

# Prints the tooling services table file $1 binds remote.
remote_tooling() {
  local n out=""
  for n in $TOOLING; do [[ "$(tooling_mode "$n" "$1")" == remote ]] && out="${out:+$out }$n"; done
  echo "$out"
}

# Starts the given tooling services, without recreating running ones, and waits for each one's /health.
start_tooling() {
  local services="$1" svc
  [[ -n "$services" ]] || return 0
  say "Starting tooling services: $services"
  # shellcheck disable=SC2086
  quiet_compose up -d --build --no-recreate $services
  for svc in $services; do wait_for_service "$svc"; done
}

# Stops the tooling services that aren't in the given list.
stop_unused_tooling() {
  local services="$1" svc
  for svc in $TOOLING; do
    case " $services " in
      *" $svc "*) ;;
      *) quiet_compose rm -sf "$svc" >/dev/null 2>&1 || true ;;
    esac
  done
}

# Prints the stage a table file is, e.g. "1b" or "2 --weight 50", or nothing if it isn't one.
match_stage() {
  local s w f="$RUN_DIR/match.yaml"
  # Tooling entries don't change the stage.
  split_tooling "$1" keep > "$f"
  for s in $STAGES; do
    cmp -s "$f" "$ENV_DIR/addresses/stage-$s.yaml" && { echo "$s"; return; }
  done
  w="$(sed -nE 's/^[[:space:]]*weight:[[:space:]]*([0-9]+).*/\1/p' "$f")"
  if [[ -n "$w" ]] && sed -E "s/^([[:space:]]*weight:).*/\1 $w/" "$ENV_DIR/addresses/stage-2.yaml" | cmp -s - "$f"; then
    echo "2 --weight $w"
  fi
}

cmd_stage() {
  [[ $# -ge 1 ]] || die "usage: ./demo stage <id> [--weight N]"
  local stage="$1" weight=""
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --weight) [[ $# -ge 2 ]] || die "--weight needs a value"; weight="$2"; shift 2 ;;
      *) die "unknown option '$1'" ;;
    esac
  done
  stage_config "$stage"
  local src
  src="$(addresses_file "$stage")"
  if [[ -n "$weight" ]]; then
    [[ "$stage" == 2 ]] || die "--weight only applies to stage 2"
    [[ "$weight" =~ ^[0-9]+$ && "$weight" -le 100 ]] || die "--weight must be 0-100"
  fi

  say "Stage $stage: $DESCRIPTION"

  # Build what the stage needs before touching the running state.
  case " $SERVICES " in *" java-pricing "*) build_java_image "$JAVA_VERSION" ;; esac

  # Render the new address table and show the governor's change against the active one.
  mkdir -p "$RUN_DIR"
  local label="stage-$stage.yaml"
  if [[ -n "$weight" ]]; then
    label="stage-$stage.yaml (weight $weight)"
    sed -E "s/^([[:space:]]*weight:).*/\1 $weight/" "$src" > "$RUN_DIR/addresses.next.yaml"
  else
    cp "$src" "$RUN_DIR/addresses.next.yaml"
  fi
  # Keep the tooling where it is.
  [[ -f "$RUN_DIR/tooling.yaml" ]] && cat "$RUN_DIR/tooling.yaml" >> "$RUN_DIR/addresses.next.yaml"
  show_change "$RUN_DIR/addresses.next.yaml" "$label"

  export JAVA_VERSION
  export APP_FOLD_IN="$FOLD_IN"
  if [[ "$FOLD_IN" == true ]]; then export APP_VARIANT=foldin; else export APP_VARIANT=remote; fi

  # 1. Start the services this stage routes to, and wait until each answers /health.
  start_services "$SERVICES"
  start_tooling "$(remote_tooling "$RUN_DIR/addresses.next.yaml")"

  # 2. Switch the app's routing: live if the running build fits, otherwise (re)create the app.
  local current_variant=""
  [[ -f "$RUN_DIR/variant" ]] && current_variant="$(cat "$RUN_DIR/variant")"
  if app_running && [[ "$current_variant" == "$APP_VARIANT" ]]; then
    say "Switching routing in the running app (no restart)"
    if ! post_table "$RUN_DIR/addresses.next.yaml" "$label"; then
      rm -f "$RUN_DIR/addresses.next.yaml"
      die "stage $stage not applied; the previous stage is still live"
    fi
    mv "$RUN_DIR/addresses.next.yaml" "$RUN_DIR/addresses.yaml"
  else
    if [[ -z "$current_variant" ]]; then
      say "Starting the app"
    elif [[ "$APP_VARIANT" == foldin ]]; then
      say "Rebuilding the app with pricing-calc-core folded in (a binding change can't add code to a running app)"
    else
      say "Rebuilding the app without pricing-calc-core"
    fi
    mv "$RUN_DIR/addresses.next.yaml" "$RUN_DIR/addresses.yaml"
    quiet_compose up -d --build --force-recreate --no-deps app
    echo "$APP_VARIANT" > "$RUN_DIR/variant"
    wait_for_app
  fi
  echo "$stage" > "$RUN_DIR/stage"

  # 3. Stop services the new routing no longer uses.
  stop_unused_services "$SERVICES"

  local tooling
  tooling="$(remote_tooling "$RUN_DIR/addresses.yaml")"
  say "Stage $stage is up. Running: app${SERVICES:+ $SERVICES}${tooling:+ $tooling}"
}

cmd_apply() {
  [[ $# -eq 1 ]] || die "usage: ./demo apply <address-table.yaml>"
  local file="$1"
  [[ -f "$file" ]] || die "no such file: $file"
  app_running || die "the app isn't running. Start a stage first, e.g. ./demo stage 0"
  mkdir -p "$RUN_DIR"
  local name label
  name="$(basename "$file")"
  label="$name"
  show_change "$file" "$label"
  post_table "$file" "$label" || exit 1
  cp "$file" "$RUN_DIR/addresses.yaml"
  # Its tooling entries, if any, are now the ones ./demo keeps.
  split_tooling "$file" tooling > "$RUN_DIR/tooling.yaml"
  [[ -s "$RUN_DIR/tooling.yaml" ]] || rm -f "$RUN_DIR/tooling.yaml"
  # Name the stage if this is one of the stage tables; otherwise record it as custom.
  case "$name" in
    stage-*.yaml) echo "${name#stage-}" | sed 's/\.yaml$//' > "$RUN_DIR/stage" ;;
    *) echo "custom:$name" > "$RUN_DIR/stage" ;;
  esac
  echo "Note: apply changes routing only. Start or stop services yourself, or use ./demo stage."
}

cmd_propose() {
  mkdir -p "$RUN_DIR"
  local raw status
  raw="$(curl -sS -X POST "$APP_URL/governor/proposals")" || die "cannot reach the app at $APP_URL"
  status="$(jq -r '.status // "error"' <<< "$raw")"
  case "$status" in
    proposed)
      local id matched generation
      id="$(jq -r .proposal.id <<< "$raw")"
      generation="$(jq -r .proposal.basedOnGeneration <<< "$raw")"
      echo "$id" > "$RUN_DIR/last-proposal"
      jq -j .proposal.fromTable <<< "$raw" > "$RUN_DIR/proposal.from.yaml"
      jq -j .proposal.toTable <<< "$raw" > "$RUN_DIR/proposal.yaml"
      matched="$(match_stage "$RUN_DIR/proposal.yaml")"
      say "Proposal $id"
      jq -r '.proposal | "  rule:      \(.rule)\n  why:       \(.why)" + (if .gate then "\n  evidence:  \(.gate)" else "" end)' <<< "$raw"
      [[ -n "$matched" ]] && echo "  this is:   stage ${matched/ --weight / at weight }"
      say "Proposed change:"
      diff -u --label "live (generation $generation)" --label "proposal $id" \
        "$RUN_DIR/proposal.from.yaml" "$RUN_DIR/proposal.yaml" || true
      if [[ "$(jq -r .proposal.needsRebuild <<< "$raw")" == true ]]; then
        echo
        echo "This folds the module into the app, which the running build can't do live."
        echo "Approving it rebuilds the app with this table."
      fi
      echo
      echo "Nothing changes until a human approves it:  ./demo approve $id"
      ;;
    waiting)
      say "Waiting: the governor won't propose yet"
      jq -r '.reasons[] | "  - \(.)"' <<< "$raw" ;;
    holding)
      say "Holding (rule $(jq -r .rule <<< "$raw"))"
      jq -r '"  \(.why)", (.details[] | "  - \(.)")' <<< "$raw" ;;
    no-change)
      say "No proposal"
      jq -r '"  \(.reason)"' <<< "$raw" ;;
    *)
      echo "The governor couldn't look at the system: $(jq -r '.reason // .' <<< "$raw")" >&2
      return 1 ;;
  esac
}

cmd_approve() {
  mkdir -p "$RUN_DIR"
  local id="${1:-}"
  if [[ -z "$id" ]]; then
    [[ -f "$RUN_DIR/last-proposal" ]] || die "usage: ./demo approve <proposal-id> (see ./demo propose)"
    id="$(cat "$RUN_DIR/last-proposal")"
  fi
  local raw code
  raw="$(curl -sS -w '\n%{http_code}' "$APP_URL/governor/proposals/$id")" || die "cannot reach the app at $APP_URL"
  code="${raw##*$'\n'}"
  raw="${raw%$'\n'*}"
  [[ "$code" == 200 ]] || die "no pending proposal '$id'. Ask for a new one: ./demo propose"
  jq -j .toTable <<< "$raw" > "$RUN_DIR/proposal.yaml"
  local matched
  matched="$(match_stage "$RUN_DIR/proposal.yaml")"

  if [[ "$(jq -r .needsRebuild <<< "$raw")" == true ]]; then
    # Approval always goes through the governor, which checks the system hasn't moved on since the proposal.
    code="$(curl -sS -o "$RUN_DIR/approve.json" -w '%{http_code}' -X POST "$APP_URL/governor/proposals/$id/approve")" \
      || die "cannot reach the app at $APP_URL"
    if [[ "$(jq -r .status "$RUN_DIR/approve.json")" != needs-rebuild ]]; then
      echo "Not applied: $(jq -r '.reason // .' "$RUN_DIR/approve.json")" >&2
      exit 1
    fi
    [[ "$matched" == 4 ]] || die "proposal $id needs a rebuild that ./demo can't do automatically; apply it by hand"
    say "Approved $id. The governor says it needs a rebuild:"
    echo "  $(jq -r .how "$RUN_DIR/approve.json")"
    cmd_stage 4
    return
  fi

  # The governor proposes tables; it doesn't run containers. Start what the proposal routes to first.
  local services="" url host java_address
  for url in $(jq -r '.toRoles[] | select(.bindingType == "remote") | .url' <<< "$raw"); do
    host="$(sed -E 's|^[a-z]+://([^:/]+).*|\1|' <<< "$url")"
    # The tooling is already where the table says, and the governor never moves it.
    case " $TOOLING " in *" $host "*) continue ;; esac
    case " $services " in *" $host "*) ;; *) services="${services:+$services }$host" ;; esac
  done
  java_address="$(jq -r '[.toRoles[] | select((.url // "") | contains("java-pricing")) | .address][0] // empty' <<< "$raw")"
  if [[ -n "$java_address" ]]; then
    JAVA_VERSION="v$(sed -E 's|.*@([^?]+).*|\1|' <<< "$java_address")"
  else
    JAVA_VERSION=v2.1
  fi
  export APP_VARIANT=remote APP_FOLD_IN=false
  start_services "$services"

  say "Approving $id"
  code="$(curl -sS -o "$RUN_DIR/approve.json" -w '%{http_code}' -X POST "$APP_URL/governor/proposals/$id/approve")" \
    || die "cannot reach the app at $APP_URL"
  if [[ "$code" != 200 ]]; then
    echo "Not applied: $(jq -r '.reason // .how // .' "$RUN_DIR/approve.json")" >&2
    exit 1
  fi
  echo "Applied without restart: generation $(jq -r .generation "$RUN_DIR/approve.json")"
  cp "$RUN_DIR/proposal.yaml" "$RUN_DIR/addresses.yaml"
  if [[ -n "$matched" ]]; then echo "${matched%% *}" > "$RUN_DIR/stage"; else echo "custom:governor $id" > "$RUN_DIR/stage"; fi
  stop_unused_services "$services"
  local tooling
  tooling="$(remote_tooling "$RUN_DIR/addresses.yaml")"
  say "Now running: app${services:+ $services}${tooling:+ $tooling}${matched:+  (stage ${matched/ --weight / at weight })}"
}

cmd_tooling() {
  local mode="${1:-}" which="${2:-all}" names n m block=""
  [[ "$mode" == local || "$mode" == remote ]] || die "usage: ./demo tooling <local|remote> [inventory|governor]"
  case "$which" in
    all) names="$TOOLING" ;;
    inventory|governor) names="$which" ;;
    *) die "usage: ./demo tooling <local|remote> [inventory|governor]" ;;
  esac
  app_running && [[ -f "$RUN_DIR/addresses.yaml" ]] || die "the app isn't running. Start a stage first, e.g. ./demo stage 0"

  # The live table with new tooling entries. Only a human moves the tooling; the governor can't.
  for n in $TOOLING; do
    m="$(tooling_mode "$n" "$RUN_DIR/addresses.yaml")"
    case " $names " in *" $n "*) m="$mode" ;; esac
    block="$block$(tooling_entry "$n" "$m")"$'\n'
  done
  { split_tooling "$RUN_DIR/addresses.yaml" keep; printf '%s' "$block"; } > "$RUN_DIR/addresses.next.yaml"
  local label="tooling: inventory $(tooling_mode inventory "$RUN_DIR/addresses.next.yaml"), governor $(tooling_mode governor "$RUN_DIR/addresses.next.yaml")"
  show_change "$RUN_DIR/addresses.next.yaml" "$label"

  local remote
  remote="$(remote_tooling "$RUN_DIR/addresses.next.yaml")"
  start_tooling "$remote"
  say "Applying the table ($label)"
  if ! post_table "$RUN_DIR/addresses.next.yaml" "$label"; then
    rm -f "$RUN_DIR/addresses.next.yaml"
    die "not applied; the tooling stays where it was"
  fi
  mv "$RUN_DIR/addresses.next.yaml" "$RUN_DIR/addresses.yaml"
  printf '%s' "$block" > "$RUN_DIR/tooling.yaml"
  stop_unused_tooling "$remote"
  echo "This is a new address table, so evidence starts again: the governor waits for fresh evidence before proposing."
}

cmd_diff() {
  [[ $# -eq 2 ]] || die "usage: ./demo diff <from-stage> <to-stage>"
  diff -u --label "stage-$1.yaml" --label "stage-$2.yaml" \
    "$(addresses_file "$1")" "$(addresses_file "$2")" || true
}

cmd_quote() {
  [[ $# -ge 1 ]] || die "usage: ./demo quote <amount> [from] [to]"
  curl -fsS "$APP_URL/quote?amount=$1&from=${2:-GBP}&to=${3:-USD}" | jq .
}

cmd_status() {
  if [[ -f "$RUN_DIR/stage" ]]; then
    local stage
    stage="$(cat "$RUN_DIR/stage")"
    case " $STAGES " in
      *" $stage "*) stage_config "$stage"; say "Stage $stage: $DESCRIPTION" ;;
      *) say "Custom table (${stage#custom:}), applied with ./demo apply" ;;
    esac
    cat "$RUN_DIR/addresses.yaml"
    if app_running; then
      say "Live in the app"
      curl -fsS "$APP_URL/admin/address-table" | jq -r '"generation \(.generation), applied \(.appliedAt) from \(.source)\n  \(.routing)"'
    fi
  else
    echo "No stage started yet. Start with: ./demo stage 0"
  fi
  say "Containers"
  compose ps
}

cmd_inventory() {
  local raw
  raw="$(curl -sS "$APP_URL/inventory")" || die "cannot reach the app at $APP_URL"
  if [[ "${1:-}" == "--json" ]]; then echo "$raw" | jq .; return; fi
  if jq -e '.error' <<< "$raw" >/dev/null 2>&1; then
    echo "Inventory unavailable: $(jq -r .error <<< "$raw")"; return 1
  fi
  jq -r '
    "Inventory: \(if .ready then "READY" else "NOT READY" end)  (generation \(.generation), table from \(.tableSource))",
    "",
    "Routing and health:",
    (.placements[] | "  \(.role | . + (" " * (9 - length)))\(.address)  \(.bindingType)\(if .weight then " \(.weight)%" else "" end)  " +
      (if .health.status == "UP" then "UP (\(.health.latencyMs) ms)"
       elif .health.status == "IN_PROCESS" then "IN PROCESS"
       else "DOWN: \(.health.detail)" end)),
    "",
    "Evidence: \(.evidence.served | map(.total) | add // 0) calls served in generation \(.evidence.generation) (ready needs \(.minEvidence))",
    (if (.notReadyBecause | length) > 0 then "", "Not ready because:", (.notReadyBecause[] | "  - \(.)") else empty end),
    (if (.problems | length) > 0 then "", "Problems (reported, not acted on):", (.problems[] | "  - \(.)") else empty end),
    "",
    def state: if .planned then "PLANNED (\(.planned))"
      elif .withdrawn and (.routedAs | length) > 0 then "WITHDRAWN, but still routed as \(.routedAs | join(", "))"
      elif .withdrawn then "WITHDRAWN"
      elif (.routedAs | length) > 0 then "routed as \(.routedAs | join(", "))"
      elif .runningAs then .runningAs
      else "not routed" end;
    "Catalogue, capabilities:",
    (.catalogue[] | select(.kind != "tooling") | "  \(.address)  \(state)"),
    "",
    "Catalogue, tooling:",
    (.catalogue[] | select(.kind == "tooling") | "  \(.address)  \(state)")
  ' <<< "$raw"
}

usage() {
  cat <<EOF
Usage: ./demo <command> [args]

  stage <id> [--weight N]   Bring up a stage ($STAGES). --weight sets the canary % in stage 2.
                            Routing switches live; the app is rebuilt only to fold core in or out.
  apply <file>              Push an address table to the running app (routing only, no containers).
  diff <from> <to>          Show what the governor changes between two stages' address tables.
  quote <amount> [from] [to]  Call the app's /quote (default GBP -> USD).
  traffic [options]         Send steady /quote load (see ./demo traffic --help).
  evidence                  Show the app's /evidence summary.
  inventory [--json]        Observe the system now: routing, /health of each address, readiness, catalogue.
  propose                   Ask the governor for the next address table, with the rule and evidence behind it.
  approve [id]              Approve a proposal (default: the last one). Starts what it needs, then applies it live.
  tooling <local|remote> [inventory|governor]
                            Move the inventory and/or governor in-process (local) or to their own services
                            (remote). Human-only: the governor never proposes this. Stage changes keep it.
  gate [N]                  Pass only if every comparison has >= N consecutive matches (default 1000) and 0 mismatches.
  status                    Show the active stage, its address table and running containers.
  logs [service]            Follow container logs (evidence records are the app's JSON log lines).
  down                      Stop everything and forget the active stage.

Environment: APP_URL (default http://localhost:8080), REBUILD=1 to rebuild the Java image from its tag.
EOF
}

main() {
  local cmd="${1:-help}"
  [[ $# -gt 0 ]] && shift
  case "$cmd" in
    stage)    cmd_stage "$@" ;;
    apply)    cmd_apply "$@" ;;
    diff)     cmd_diff "$@" ;;
    quote)    cmd_quote "$@" ;;
    traffic)  exec "$ENV_DIR/scripts/traffic.sh" "$@" ;;
    evidence) curl -fsS "$APP_URL/evidence" | jq . ;;
    inventory) cmd_inventory "$@" ;;
    propose)  cmd_propose ;;
    approve)  cmd_approve "$@" ;;
    tooling)  cmd_tooling "$@" ;;
    gate)     exec "$ENV_DIR/scripts/gate.sh" "$@" ;;
    status)   cmd_status ;;
    logs)     compose logs -f "$@" ;;
    down)     compose down --remove-orphans; rm -rf "$RUN_DIR" ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 1 ;;
  esac
}

main "$@"
